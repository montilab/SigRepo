
# Each line of .Rbuildignore is a Perl-compatible regular expression
# To exclude a specific file or directory, one MUST anchor the regular expression. 
# For example, to exclude a directory called “notes”, the .Rbuildignore entry must be ^notes$, 
# whereas the unanchored regular expression notes will match any file name containing “notes”, e.g. R/notes.R, man/important-notes.R, data/endnotes.Rdata, etc.

# Ignore folders
^\.Rproj\.user
^\.git
^\.github
^docs
^pkgdown
^tests/testthat/_snaps

# Ignore extensions
^.*\.Rproj$

# Ignore specific files
^\.gitignore$
^\.dockerignore$
^\.DS_Store$
^\.Rhistory$
^\.Renviron$
^Dockerfile$
^Dockerfile-.*$
^docker-compose\.yml$
^docker-compose-.*\.yml$
^mysql\.env$
^rstudio-server\.env$
^install_r_packages\.R$
^add-rstudio-users\.sh$
^install_sigrepo\.sh$
^uninstall_sigrepo\.sh$
^_pkgdown\.yml$
^README\.Rmd$
^NEWS\.Rmd$
^refCheck\.R$
^\.Rproj\.user$
